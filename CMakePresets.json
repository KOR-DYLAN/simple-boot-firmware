{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "aarch64-bl1",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/aarch64/bl1",
      "cacheVariables": {
        "BOOT_ARCH": "aarch64",
        "BOOT_CONFIG_APPEND": "bl1.config",
        "BOOT_MULTIBUILD_ROOT": "${sourceDir}/build/aarch64"
      }
    },
    {
      "name": "aarch64-bl2",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/aarch64/bl2",
      "cacheVariables": {
        "BOOT_ARCH": "aarch64",
        "BOOT_CONFIG_APPEND": "bl2.config",
        "BOOT_MULTIBUILD_ROOT": "${sourceDir}/build/aarch64"
      }
    },
    {
      "name": "aarch32-bl1",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/aarch32/bl1",
      "cacheVariables": {
        "BOOT_ARCH": "aarch32",
        "BOOT_CONFIG_APPEND": "bl1.config",
        "BOOT_MULTIBUILD_ROOT": "${sourceDir}/build/aarch32"
      }
    },
    {
      "name": "aarch32-bl2",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/aarch32/bl2",
      "cacheVariables": {
        "BOOT_ARCH": "aarch32",
        "BOOT_CONFIG_APPEND": "bl2.config",
        "BOOT_MULTIBUILD_ROOT": "${sourceDir}/build/aarch32"
      }
    },
    {
      "name": "cortex-m-bl1",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/cortex-m/bl1",
      "cacheVariables": {
        "BOOT_ARCH": "cortex-m",
        "BOOT_CONFIG_APPEND": "bl1.config",
        "BOOT_MULTIBUILD_ROOT": "${sourceDir}/build/cortex-m"
      }
    },
    {
      "name": "cortex-m-bl2",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/cortex-m/bl2",
      "cacheVariables": {
        "BOOT_ARCH": "cortex-m",
        "BOOT_CONFIG_APPEND": "bl2.config",
        "BOOT_MULTIBUILD_ROOT": "${sourceDir}/build/cortex-m"
      }
    }
  ],
  "buildPresets": [
    { "name": "aarch64-bl1", "configurePreset": "aarch64-bl1" },
    { "name": "aarch64-bl2", "configurePreset": "aarch64-bl2" },
    { "name": "aarch32-bl1", "configurePreset": "aarch32-bl1" },
    { "name": "aarch32-bl2", "configurePreset": "aarch32-bl2" },
    { "name": "cortex-m-bl1", "configurePreset": "cortex-m-bl1" },
    { "name": "cortex-m-bl2", "configurePreset": "cortex-m-bl2" }
  ]
}
