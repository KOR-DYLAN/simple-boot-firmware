{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "aarch64",
      "inherits": "base",
      "cacheVariables": {
        "BOOT_ARCH": "aarch64"
      }
    },
    {
      "name": "aarch32",
      "inherits": "base",
      "cacheVariables": {
        "BOOT_ARCH": "aarch32"
      }
    },
    {
      "name": "cortex-m",
      "inherits": "base",
      "cacheVariables": {
        "BOOT_ARCH": "cortex-m"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "aarch64",
      "configurePreset": "aarch64"
    },
    {
      "name": "aarch32",
      "configurePreset": "aarch32"
    },
    {
      "name": "cortex-m",
      "configurePreset": "cortex-m"
    }
  ]
}
