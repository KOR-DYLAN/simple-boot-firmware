# File: cmake/boot.gdb.in
# Brief: Load both bootloader symbol files and connect to the debug server.

set pagination off
set confirm off
file "@BOOTLOADER1_ELF@"
add-symbol-file "@BOOTLOADER2_ELF@"
target remote 127.0.0.1:@BOOT_GDB_PORT@
tbreak boot_main
display/i $pc
echo Connected at bootloader1 startup. Use 'si' or 'continue'.\n
